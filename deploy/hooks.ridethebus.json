{
  "id": "deploy-ridethebus",
  "execute-command": "/opt/deploy-ridethebus.sh",
  "command-working-directory": "/var/www/ridethebus",
  "response-message": "Deploying ridethebus",
  "trigger-rule": {
    "and": [
      {
        "match": {
          "type": "payload-hmac-sha256",
          "secret": "REPLACE_WITH_WEBHOOK_SECRET",
          "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
        }
      },
      {
        "match": {
          "type": "value",
          "value": "refs/heads/main",
          "parameter": { "source": "payload", "name": "ref" }
        }
      }
    ]
  }
}
