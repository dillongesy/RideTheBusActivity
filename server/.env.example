# Discord application credentials (Developer Portal -> your app -> OAuth2).
# Copy this file to `.env` and fill in real values.
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Only needed to run register-entry-point.js (one-time Activity launch command).
# Developer Portal -> Bot -> Reset Token. Not needed for the running server.
DISCORD_BOT_TOKEN=your_bot_token_here

# Port the backend listens on (Vite dev proxy expects 3001).
PORT=3001
